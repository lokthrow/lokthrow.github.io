---
import type { App } from '../data/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<a href={`/apps/${app.slug}`} class="card" style={`--app-accent: ${app.accent}`}>
  <img src={app.icon} alt="" class="icon" width="64" height="64" loading="lazy" />
  <h3>{app.name}</h3>
  <p class="muted">{app.tagline}</p>
  <ul class="tags">
    {app.tech.slice(0, 3).map((t) => <li>{t}</li>)}
  </ul>
  <span class="more">Ver proyecto →</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--app-accent);
    box-shadow: 0 18px 40px -24px var(--app-accent);
  }
  .icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    margin-bottom: 14px;
  }
  h3 {
    margin: 0;
  }
  .tags {
    margin-top: auto;
    padding-top: 12px;
  }
  .more {
    margin-top: 16px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--app-accent);
  }
</style>
