---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} {site.name}</p>
    <ul>
      {site.links.map((link) => (
        <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>
      ))}
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
</style>
