---
import Layout from '../layouts/Layout.astro';
import AppCard from '../components/AppCard.astro';
import { apps } from '../data/apps';
import { site } from '../data/site';

const skills = [
  {
    title: 'React Native',
    text: 'Apps multiplataforma con TypeScript y actualizaciones OTA para corregir y avanzar rápidamente.',
  },
  {
    title: 'De la idea a la tienda',
    text: 'Diseño, desarrollo, publicación en App Store y Google Play y mantenimiento de versiones.',
  },
  {
    title: 'Datos en el dispositivo',
    text: 'SQLite, llavero del sistema y biometría. Mis apps funcionan sin cuentas y sin mandar tus datos a ningún servidor.',
  },
  {
    title: 'Monetización',
    text: 'Suscripciones con compras integradas y publicidad con AdMob, sin estropear la experiencia.',
  },
];
---

<Layout>
  <section class="hero section">
    <div class="container hero-inner">
      <div>
        <span class="eyebrow">{site.role}</span>
        <h1>Hola, soy Alejandro.<br />Hago apps que la gente usa a diario.</h1>
        <p class="lead">
          Desarrollo aplicaciones móviles para iOS y Android con React Native. Tengo tres publicadas:
          MiraBolsa, Para y Siente y TDiary.
        </p>
        <div class="actions">
          <a href="#apps" class="button">Ver mis apps</a>
          <a href="#contacto" class="button ghost">Escríbeme</a>
        </div>
      </div>
      <img src="/img/alejandro.webp" alt="Foto de Alejandro Muñoz" class="avatar" width="220" height="220" />
    </div>
  </section>

  <section id="apps" class="section">
    <div class="container">
      <span class="eyebrow">Proyectos</span>
      <h2>Apps publicadas</h2>
      <p class="lead">Las tres están en App Store y Google Play, y las he hecho de principio a fin.</p>
      <div class="grid">
        {apps.map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>

  <section id="sobre-mi" class="section about">
    <div class="container about-inner">
      <div>
        <span class="eyebrow">Sobre mí</span>
        <h2>Un desarrollador, de principio a fin</h2>
        <p>
          Empecé haciendo apps nativas: TDiary lo escribí en Java para Android y en Swift para iOS. Mantener
          dos bases de código para una sola persona es mucho trabajo, así que me pasé a React Native. Desde entonces
          todas mis apps comparten una única base de código en TypeScript.
        </p>
        <p>
          Me gusta resolver problemas concretos. MiraBolsa nació porque consultar la posición en las bolsas de
          interinos obligaba a entrar en un portal distinto por cada comunidad. Para y Siente salió de trabajar con
          Mónica, psicóloga, en una herramienta para gestionar las emociones en el día a día.
        </p>
      </div>
      <div class="skills">
        {skills.map((skill) => (
          <div class="skill">
            <h3>{skill.title}</h3>
            <p class="muted">{skill.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contacto" class="section">
    <div class="container contact">
      <span class="eyebrow">Contacto</span>
      <h2>¿Hablamos?</h2>
      <p class="lead">Si tienes una idea de app, una duda sobre alguna de las mías o quieres colaborar, escríbeme.</p>
      <a href={`mailto:${site.email}`} class="button">{site.email}</a>
      <ul class="links">
        {site.links.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 96px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .avatar {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--surface);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.35);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .about {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
  }
  .about-inner p a {
    color: var(--accent);
  }
  .skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
    align-content: start;
    padding-top: 40px;
  }
  .skill p {
    font-size: 0.95rem;
    margin: 0;
  }
  .contact {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .contact .lead {
    margin-bottom: 28px;
  }
  .links {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }
  .links a:hover {
    color: var(--text);
  }
  @media (max-width: 820px) {
    .hero-inner,
    .about-inner {
      grid-template-columns: 1fr;
    }
    .avatar {
      grid-row: 1;
      width: 120px;
      height: 120px;
    }
    .skills {
      padding-top: 0;
    }
  }
  @media (max-width: 480px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
